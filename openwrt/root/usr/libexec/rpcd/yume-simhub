#!/usr/bin/python3 -sB
"""Narrow rpcd interface. No shell commands or caller-controlled cloud paths."""
import json
import os
import re
from pathlib import Path
import subprocess
import sys
import urllib.error
sys.dont_write_bytecode=True
os.umask(0o077)
BASE=Path('/etc/yume-simhub')
BOOT=BASE/'bootstrap.json'
METHODS={'health':{},'status':{},'configure':{'token':'','enabled':True},'settings':{},'save_settings':{'settings':{}},'switch':{'device':''},'service':{'action':''},'preferences':{'language':'','appearance':''},'action':{'operation':'','id':'','code':'','before':''},'select_module':{'location':''}}

def cloud(path, body=None, method=None):
    import urllib.request
    cfg=json.loads(BOOT.read_text())
    req=urllib.request.Request('https://worker.example.com'+path,data=json.dumps(body).encode() if body is not None else None,
        method=method,headers={'Authorization':'Bearer '+cfg['token'],'Content-Type':'application/json','User-Agent':'YumeSIMHub/27.2.0'})
    with urllib.request.urlopen(req,timeout=8) as response:
        return json.loads(response.read(262144))

def service(action):
    if action not in ('start','stop','restart','enable','disable'):raise ValueError('Invalid service action')
    subprocess.run(['/etc/init.d/yume-simhub',action],check=True,timeout=30,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)

def execute(method, v):
    if method=='configure':
        import urllib.request
        BASE.mkdir(mode=0o700,parents=True,exist_ok=True);os.chmod(BASE,0o700)
        cfg=json.loads(BOOT.read_text()) if BOOT.exists() else {'origin':'https://worker.example.com'}
        token=v.get('token','')
        if token:
            if not isinstance(token,str) or not 32<=len(token)<=512 or any(c.isspace() for c in token):raise ValueError('Invalid credential')
            cfg['token']=token
        if not cfg.get('token'):raise ValueError('Client credential required')
        # Verify before replacing working credentials.
        req=urllib.request.Request(cfg['origin']+'/edge/state',headers={'Authorization':'Bearer '+cfg['token'],'User-Agent':'YumeSIMHub/27.2.0'})
        with urllib.request.urlopen(req,timeout=8) as response:response.read(262144)
        temp=BOOT.with_suffix('.tmp');temp.write_text(json.dumps(cfg));os.chmod(temp,0o600);temp.replace(BOOT)
        enabled=v.get('enabled')
        if type(enabled) is not bool:raise ValueError('Invalid enabled setting')
        subprocess.run(['/sbin/uci','set','yume-simhub.main.enabled='+('1' if enabled else '0')],check=True)
        subprocess.run(['/sbin/uci','commit','yume-simhub'],check=True)
        service('enable' if enabled else 'disable');service('restart' if enabled else 'stop')
        return {'ok':True}
    if method=='select_module':
        service_state=json.loads(subprocess.check_output(['ubus','call','service','list','{"name":"yume-simhub"}'],timeout=2))
        if any(item.get('running') for item in service_state.get('yume-simhub',{}).get('instances',{}).values()):raise ValueError('Stop service before changing modules')
        location=v.get('location','')
        if not isinstance(location,str) or (location and not re.fullmatch(r'[0-9]{1,10}',location)):raise ValueError('Invalid physical module selection')
        subprocess.run(['/sbin/uci','set','yume-simhub.main.module_location='+location],check=True)
        subprocess.run(['/sbin/uci','commit','yume-simhub'],check=True)
        return {'ok':True}
    if method=='action':
        operation=v.get('operation');identity=v.get('id','')
        if not isinstance(identity,str) or len(identity)>256:raise ValueError('Invalid record identity')
        if operation in ('remove_sms','remove_jobs','clear_sms','clear_jobs'):
            from urllib.parse import quote
            kind='sms' if operation.endswith('sms') else 'jobs'
            path='/edge/history/'+kind
            if operation.startswith('remove_'):
                if not identity:raise ValueError('Missing record identity')
                path+='/'+quote(identity,safe='')
            return cloud(path,method='DELETE')
        if operation in ('recording_delete','recording_retry','recording_ticket'):
            if not re.fullmatch(r'RE[a-f0-9]{32}',identity):raise ValueError('Invalid recording')
            suffix='' if operation=='recording_delete' else '/'+operation.split('_',1)[1]
            return cloud('/edge/recordings/'+identity+suffix,{} if suffix else None,'POST' if suffix else 'DELETE')
        if operation=='recordings_clear':return cloud('/edge/recordings',method='DELETE')
        if operation=='recordings_more':
            before=str(v.get('before',''))
            if not re.fullmatch(r'[0-9]{1,16}',before):raise ValueError('Invalid recording cursor')
            return {'recordings':cloud('/edge/recordings?before='+before)}
        if operation=='notify_retry':return cloud('/edge/notify-retry',{})
        if operation=='notify_test':return cloud('/edge/notify-test',{})
        if operation=='logs':
            path=Path('/tmp/yume-simhub/runtime.log')
            if not path.exists():return {'log':''}
            with path.open('rb') as stream:
                stream.seek(max(0,path.stat().st_size-18000));return {'log':stream.read(18000).decode(errors='replace')}
        if operation=='logs_clear':
            path=Path('/tmp/yume-simhub/runtime.log')
            if path.exists():path.write_text('')
            return {'ok':True}
        if operation=='totp_setup':return cloud('/edge/totp/setup',{})
        if operation=='totp_confirm':
            code=v.get('code','')
            if not re.fullmatch(r'[0-9]{6}',code):raise ValueError('Invalid one-time code')
            return cloud('/edge/totp/confirm',{'code':code})
        raise ValueError('Unknown operation')
    if method=='preferences':
        language=v.get('language');appearance=v.get('appearance')
        if language not in ('system','en','fr','ja','zh-Hans','zh-Hant') or appearance not in ('system','light','dark'):raise ValueError('Invalid interface preferences')
        for key,value in [('ui_language',language),('appearance',appearance)]:
            subprocess.run(['/sbin/uci','set','yume-simhub.main.'+key+'='+value],check=True)
        subprocess.run(['/sbin/uci','commit','yume-simhub'],check=True)
        return {'ok':True}
    if method=='health':
        import time
        try:local=json.loads(Path('/tmp/yume-simhub/edge-health.json').read_text())
        except (OSError,ValueError):local={}
        if not 0<=time.time()*1000-local.get('updated',0)<12000:
            local.update(modemConnected=False,voiceReady=False,sipRegistered=False,busy=False)
        try:
            services=json.loads(subprocess.check_output(['ubus','call','service','list','{"name":"yume-simhub"}'],timeout=1))
            running=any(item.get('running') for item in services.get('yume-simhub',{}).get('instances',{}).values())
        except Exception:running=False
        return {'local':local,'running':running}
    if method=='status':
        result={'configured':BOOT.exists(),'local':{},'runtime':{},'error':'','version':json.loads(Path('/usr/lib/yume-simhub/version.json').read_text())}
        try:result['local']=json.loads(Path('/tmp/yume-simhub/edge-health.json').read_text())
        except (OSError,ValueError):pass
        def preference(key,default):
            value=subprocess.run(['/sbin/uci','-q','get','yume-simhub.main.'+key],capture_output=True,text=True,timeout=2)
            return value.stdout.strip() if value.returncode==0 else default
        result['preferences']={'module_location':preference('module_location',''),'language':preference('ui_language','system'),'appearance':preference('appearance','system'),'enabled':preference('enabled','0')=='1'}
        try:
            service_state=json.loads(subprocess.check_output(['ubus','call','service','list','{"name":"yume-simhub"}'],timeout=2))
            result['running']=any(item.get('running') for item in service_state.get('yume-simhub',{}).get('instances',{}).values())
        except Exception:result['running']=False
        result['modules']=[]
        try:
            sys.path.insert(0,'/usr/lib/yume-simhub/tools')
            import usb.core,usb_backend,module_select
            for vendor,product in module_select.IDS:
                for device in usb.core.find(find_all=True,idVendor=vendor,idProduct=product,backend=usb_backend.backend):
                    result['modules'].append({'id':str(module_select.usb_location(device)),'label':'DJI QDC507 · USB '+str(device.bus)+'-'+'.'.join(str(p) for p in device.port_numbers)})
        except Exception:pass
        identity=BASE/'device-id'
        if identity.exists():result['device']=identity.read_text().strip()
        return result
    if method=='settings':
        result=cloud('/edge/state')
        try:result['recordings']=cloud('/edge/recordings')
        except Exception:result['recordings']=[]
        return result
    if method=='save_settings':
        value=v.get('settings')
        if not isinstance(value,dict):raise ValueError('Invalid settings')
        return cloud('/edge/settings',value,'PUT')
    if method=='switch':return cloud('/edge/runtime/select',{'device':v.get('device')})
    if method=='service':
        service(v.get('action'));return {'ok':True}
    raise ValueError('Unknown method')

if __name__=='__main__':
    if len(sys.argv)>1 and sys.argv[1]=='list':print(json.dumps(METHODS))
    elif len(sys.argv)>2 and sys.argv[1]=='call':
        try:
            data=sys.stdin.buffer.read(16385)
            if len(data)>16384:raise ValueError('Request too large')
            print(json.dumps(execute(sys.argv[2],json.loads(data or b'{}'))))
        except urllib.error.HTTPError as error:
            try:message=json.loads(error.read(4096)).get('error','')
            except Exception:message=''
            print(json.dumps({'error':message or 'Cloud request rejected (HTTP %s)'%error.code}))
        except Exception:
            print(json.dumps({'error':'Operation failed; verify settings, dependencies and service state'}))
