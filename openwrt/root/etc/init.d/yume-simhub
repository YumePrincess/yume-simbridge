#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    local enabled module_location
    config_load yume-simhub
    config_get_bool enabled main enabled 0
    config_get module_location main module_location ""
    [ "$enabled" = 1 ] || return 0
    [ -s /etc/yume-simhub/bootstrap.json ] || return 1
    umask 077
    mkdir -p /tmp/yume-simhub /etc/yume-simhub/data
    chmod 700 /tmp/yume-simhub /etc/yume-simhub /etc/yume-simhub/data
    # Persistent SMS spool is kept on overlay; volatile health/FIFOs use /tmp.
    procd_open_instance
    procd_set_param command /usr/bin/python3 -s -B -u /usr/lib/yume-simhub/supervisor.py --config /etc/yume-simhub/bootstrap.json --data /tmp/yume-simhub
    procd_set_param env PYTHONDONTWRITEBYTECODE=1 SIMHUB_DATABASE=/etc/yume-simhub/data/messages.sqlite "SIMHUB_MODULE_LOCATION=$module_location"
    procd_set_param respawn 3600 10 0
    procd_set_param term_timeout 20
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() {
    procd_add_reload_trigger yume-simhub
}
