{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yume-simhub",
  "account_id": "8945f9d46f2b03639bc88d37424f1052",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "worker.example.com", "custom_domain": true }],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "services": [{ "binding": "GOTIFY", "service": "yume-gotify" }],
  "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "yume-oss" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yume-simhub",
      "database_id": "0a266f2a-3320-4e41-8db4-50ea055ad3f4",
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://worker.example.com",
    "TWILIO_ACCOUNT_SID": "ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
    "TWILIO_NUMBER": "+12025550124",
    "EMAIL_ADDRESS": "sms@example.com",
  },
  "secrets": { "required": ["MASTER_KEY", "EDGE_TOKEN", "RECORDING_KEY"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "send_metrics": false,
}
